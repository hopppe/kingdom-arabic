{
  "expo": {
    "name": "Kingdom Arabic",
    "slug": "LearnArabic",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4a3a5c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ingenuitylabs.kingdomarabic",
      "buildNumber": "3",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "UIRequiresFullScreen": true,
        "NSUserNotificationsUsageDescription": "Kingdom Arabic uses notifications to send you daily study reminders to help you stay consistent with your Arabic Bible learning.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4a3a5c"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ingenuitylabs.LearnArabic",
      "versionCode": 2,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4a3a5c",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "16464cd3-8786-4a65-9df0-b8bcd64a0915"
      }
    }
  }
}
